# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets & local settings
.env
.claude/settings.local.json
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# Data & outputs: reproducible, not versioned (see CLAUDE.md)
data/*
!data/.gitkeep
runs/*
!runs/.gitkeep

# Large binaries (model weights etc.): link them from the wiki instead
*.ckpt
*.pt
*.pth
*.safetensors
*.h5

# Cluster keys and credentials: NEVER commit these
*.pem
*.key
id_rsa*
id_ed25519*
.aws/
credentials

# Organizers' tools: fetched per machine with aws s3 cp (see wiki/submission.md), not ours to version
validate-submission.py
submit-designs.sh

# pre_analysis/: bulk downloads and regenerable intermediates (re-created by its scripts, see pre_analysis/README.md)
pre_analysis/**/structures/**/*.cif
pre_analysis/**/structures/**/*.pdb
pre_analysis/**/*.pkl
pre_analysis/**/*.pse
pre_analysis/kemp_eliminase/code/
pre_analysis/kemp_eliminase/theozyme/rosetta_denovoKemp/
pre_analysis/kemp_theozymes_v2/candidates_v2.csv
